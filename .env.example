# ==============================================================================
# AI Writing Studio - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production-use-a-strong-random-secret-key-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000,http://localhost

# Database (PostgreSQL)
POSTGRES_DB=aiwritingstudio
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=studio_secret_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==============================================================================
# Multi-Provider AI Engine (Cloud-First & Self-Hosted)
# ==============================================================================
# Primary Provider: 'openrouter', 'gemini', 'openai', 'ollama', or 'auto'
AI_PROVIDER=openrouter

# OpenRouter (Primary Recommended Provider - Blazing Fast & Cost Efficient)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini (High Speed Creative & Multilingual)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (Configurable from backend or UI settings)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Local Ollama (Only used if explicitly selected or running local models)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=180

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=writing_references

# Authentication (JWT)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# AI Limits & RAG Tuning
AI_MAX_INPUT_LENGTH=12000
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT=180
AI_TOP_K=4
AI_SIMILARITY_THRESHOLD=0.65
AI_CACHE_TTL=86400

# File Uploads
MAX_UPLOAD_SIZE_MB=15

# Ports Configuration (for host machine bindings)
PORT_NGINX=80
PORT_FRONTEND=3000
PORT_BACKEND=8000
PORT_OLLAMA=11434
PORT_QDRANT=6333
